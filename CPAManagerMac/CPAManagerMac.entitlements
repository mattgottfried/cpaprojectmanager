<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Shared with the Mac widgets (dashboard snapshot, "complete task" queue). macOS group
	     IDs start with the Team ID; iOS uses the "group." form. See AppGroup.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.com.gottfriedcpa.ProjectManager</string>
	</array>
	<!-- Firebase Auth stores its session in the keychain; sandboxed Mac apps need a group. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.gottfriedcpa.ProjectManager</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Calendar + Reminders (EventKit) -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.gottfriedcpa.ProjectManager</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Silent pushes so CloudKit changes arrive while the app is running. Xcode swaps
	     this to "production" when archiving. -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
</dict>
</plist>
