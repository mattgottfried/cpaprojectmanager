<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Shares the dashboard snapshot and the "complete task" queue with the Mac app.
	     macOS group IDs start with the Team ID (see AppGroup.swift). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.com.gottfriedcpa.ProjectManager</string>
	</array>
</dict>
</plist>
